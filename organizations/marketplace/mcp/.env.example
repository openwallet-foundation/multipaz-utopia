# Marketplace Kotlin backend (Multipaz verifier + UPay). Unset ⇒ local stand-in verifier.
MARKETPLACE_KOTLIN_BASE=http://localhost:8100/marketplace

# Browser-facing base serving verify_credentials.js — must be the same origin as the buyer's page.
MARKETPLACE_VERIFIER_BASE=/marketplace

# Port the MCP server listens on; the connector URL is <origin>/mcp.
MCP_PORT=3005

# Public origin for checkout links. Unset ⇒ http://localhost:<MCP_PORT>.
# MCP_BASE_URL=

# Where the catalog is fetched from. Unset ⇒ $MARKETPLACE_KOTLIN_BASE/catalog, else http://localhost:8010/catalog.
# MARKETPLACE_CATALOG_URL=

# How long (ms) a fetched catalog is served before refreshing. Invalid values fall back to the default.
# MARKETPLACE_CATALOG_TTL_MS=60000

# Age threshold for age-restricted items (the catalog's minimumAge still applies).
# MARKETPLACE_AGE=18

# --- dev harness only (src/dev-serve.ts) ---

# Upstream that /marketplace, /registry and /upay are proxied to.
# MARKETPLACE_KOTLIN_UPSTREAM=http://localhost:8100

# Account shown by /dev/ledger (local demo merchant; the buyer card is 38445565).
# MARKETPLACE_LEDGER_ACCOUNT=10000001

# Where created orders are persisted.
# MCP_ORDERS_FILE=./.orders.json

# Where completed purchases are persisted (read by get-order-status).
# MCP_COMPLETED_ORDERS_FILE=./.completed-orders.json

# Stand-in verdict when no backend is set: ok | wrong-amount | underage | declined.
# VERDICT=ok
