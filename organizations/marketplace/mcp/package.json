{
  "name": "@utopia/marketplace-mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Utopia Marketplace MCP marketplace — CredentAgent storefront with UPay/DPC checkout hand-off.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "dev:demo": "tsx src/dev-serve.ts",
